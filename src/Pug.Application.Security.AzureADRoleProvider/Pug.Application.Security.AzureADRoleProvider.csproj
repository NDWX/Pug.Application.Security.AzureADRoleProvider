<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Product>Pug.Application.Security.AzureADRoleProvider</Product>
        <Title>Pug.Application.Security.AzureADRoleProvider</Title>
        <Authors>Andrian</Authors>
        <Description>Microsoft Entra ID (Azure AD) based implementation of Pug.Application.Security IUserRoleProvider and IPrincipalRoleProvider, mapping Entra app-role assignments to roles.</Description>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/NDWX/Pug.Application.Security.AzureADRoleProvider.git</RepositoryUrl>
        <PackageTags>Pug Application Security Role Provider AzureAD EntraID Microsoft Graph</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>Apache-2.0+</PackageLicenseExpression>
        <License>Apache2.0</License>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <AssemblyVersion>0.0.0.1</AssemblyVersion>
        <FileVersion>0.0.0.1</FileVersion>
        <PackageVersion>0.0.2</PackageVersion>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Pug.Application.Security.Abstractions" Version="3.1.0" />
        <PackageReference Include="Microsoft.Graph" Version="6.2.0" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Pug.Application.Security.AzureADRoleProvider.Tests" />
    </ItemGroup>

</Project>